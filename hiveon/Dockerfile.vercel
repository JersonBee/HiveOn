FROM eclipse-temurin:21-jdk AS build
WORKDIR /app
COPY .mvn .mvn
COPY mvnw pom.xml ./
COPY src ./src
RUN sh ./mvnw -B -ntp -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app/target/hiveon-0.0.1-SNAPSHOT.jar /app/hiveon.jar
COPY deployment/prod-ca-2021.crt /app/prod-ca-2021.crt
ENV SPRING_PROFILES_ACTIVE=vercel
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/hiveon.jar"]
